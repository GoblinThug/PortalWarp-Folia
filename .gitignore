# =========================
# PortalWarp — .gitignore
# Maven / Java / Paper / IDE
# =========================

# --- Maven ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# --- Compiled / build artifacts ---
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Keep intentional jars if ever placed under libs/ (uncomment if needed)
# !libs/*.jar

# --- Logs ---
*.log
logs/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE: IntelliJ IDEA / Cursor / VS Code ---
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/
*.code-workspace
.project
.classpath
.settings/
.factorypath
bin/
.metadata/
*.swp
*.swo
*~

# --- Eclipse / NetBeans ---
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
nbactions.xml
nb-configuration.xml

# --- Gradle (на случай смешения инструментов) ---
.gradle/
build/

# --- Local / secrets / env ---
.env
.env.*
!.env.example
*.local
secrets/
credentials.*

# --- Minecraft / Paper server (если тестируете рядом с репозиторием) ---
/server/
/run/
/test-server/
world/
world_nether/
world_the_end/
plugins/
cache/
libraries/
versions/
logs/
crash-reports/
banned-*.json
ops.json
whitelist.json
usercache.json
usernamecache.json
eula.txt
server.properties
# Root-level server configs only (do not ignore src/**/paper-plugin.yml)
/spigot.yml
/paper.yml
/paper-*.yml
/bukkit.yml
/commands.yml
/help.yml
/permissions.yml
/pufferfish.yml
/purpur.yml
/config/
session.lock
!src/main/resources/paper-plugin.yml

